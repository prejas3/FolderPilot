{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FolderPilot",
  "version": "0.1.0",
  "identifier": "com.szymonjankiewicz.folderpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FolderPilot",
        "width": 1000,
        "height": 700,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
